{
  "name": "depo-pro-local",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "status": "node scripts/local-status.mjs",
    "setup:pedalboard": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-pedalboard.ps1",
    "build": "vinext build",
    "configure": "node scripts/configure-local.mjs",
    "start": "node scripts/start-local.mjs",
    "start:ui": "vinext start",
    "backup": "node scripts/deposition-backup.mjs",
    "test": "node scripts/test-all.mjs",
    "fixture:rx": "node scripts/make-rx-fixture.mjs",
    "test:rx": "node scripts/test-rx-integration.mjs",
    "test:deepgram": "node scripts/test-deepgram-integration.mjs",
    "test:integration": "npm run test:rx",
    "typecheck": "tsc --noEmit --incremental false",
    "verify": "npm test && npm run typecheck && npm run lint && npm run build",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vinext --ignore-pattern .wrangler --ignore-pattern .verify-staged"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.0",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "node": "^22.13.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.7",
    "vite": "8.2.1",
    "wrangler": "4.124.0"
  },
  "type": "module"
}
